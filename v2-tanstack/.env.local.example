# --- Client (navigateur) : exposées au bundle, préfixe VITE_ obligatoire ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Serveur (SSR / server functions) : JAMAIS exposées au client ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# service-role = bypass RLS total, usage serveur strict (webhooks/admin)
SUPABASE_SERVICE_ROLE_KEY=
