# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Windows reserved names
nul

# Backups locaux (migration Supabase)
.backup/

# Artefacts locaux (CLI Supabase) — non versionnés
supabase/.temp/

# Assets binaires métier (documents/vidéos/retours) — hors dépôt de code.
# Motifs en * pour couvrir les deux encodages de noms accentués.
/coproflex_reel.mp4
/Cat*gorisation.png
/Logique metier/
/Ads*/
/Retour DB/
/Retour Pastel/
/Pr*sentation*/
playwright-report/
test-results/

# Tooling local (npx skills, annexes binaires) — non versionne
.agents/
.claude/skills/
skills-lock.json
.planning/refs-annexes/

# --- Hygiene repo (HY-3, 2026-06-23) ---
# Scratch lourd archive SUR DISQUE mais hors git (regenerable, chantiers merges)
.planning/_archive/2026-06-23/forms-rollout/
.planning/_archive/2026-06-23/lint-batches/
.planning/_archive/2026-06-23/lint-*.json
.planning/_archive/2026-06-23/lint-*.mjs
# Anti-recidive : artefacts de session a la racine du repo (screenshots de verif, logs, dumps)
/*.png
/*.jpg
/*.log
/tmp-*.md
# Anti-recidive : scratch / dumps / types regeneres dans .planning
.planning/lint-*.json
.planning/lint-*.mjs
.planning/*.log
.planning/_schema_dump.sql
.planning/supabase_types_regenerated.ts
